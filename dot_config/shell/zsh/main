SHELL_COMMON="$XDG_CONFIG_HOME/shell/common"
SHELL_ZSH="$XDG_CONFIG_HOME/shell/zsh"

source "$SHELL_ZSH/options"
source "$SHELL_ZSH/completions"
source "$SHELL_COMMON/aliases"
source "$SHELL_COMMON/functions"

# Common drop-in extensions
for f in "$SHELL_COMMON/extra/"*; do
    [ -f "$f" ] && . "$f"
done

# Zsh-specific drop-in extensions
for f in "$SHELL_ZSH/extra/"*; do
    [ -f "$f" ] && . "$f"
done